    "s3": {
      "ru": "Последовательно применяем каждое действие, обновляя, где находится предмет и кто его несёт.",
      "en": "Apply each action in order, updating where the item is and who carries it."
    },
    "s4": {
      "ru": "Итог: предмет «{target_item}» находится в комнате «{answer_room}».",
      "en": "Result: the {target_item} is in the {answer_room}."
    },
    "s5": {
      "ru": "{p} находится в комнате «{v1}».",
      "en": "{p} is in the {v1}."
    },
    "s6": {
      "ru": "Предмет «{it}» лежит в комнате «{v1}».",
