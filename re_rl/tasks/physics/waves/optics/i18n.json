{
  "text": {
    "s0": {
      "ru": "Полное внутреннее отражение",
      "en": "Полное внутреннее отражение"
    },
    "s1": {
      "ru": "sin(θ₂) = n₁sin(θ₁)/n₂ = {n1}×sin({angle1}°)/{n2} = {sin_theta2:.4f}",
      "en": "sin(θ₂) = n₁sin(θ₁)/n₂ = {n1}×sin({angle1}°)/{n2} = {sin_theta2:.4f}"
    },
    "s2": {
      "ru": "Полное внутреннее отражение невозможно (n₁ ≤ n₂)",
      "en": "Полное внутреннее отражение невозможно (n₁ ≤ n₂)"
    },
    "s3": {
      "ru": "{f_prime:.2f} см",
      "en": "{f_prime:.2f} см"
    },
    "s4": {
      "ru": "Изображение на бесконечности",
      "en": "Изображение на бесконечности"
    },
    "s5": {
      "ru": "f' = d·F/(d-F) = {d}×{f}/({d_2}-{f_2}) = {f_prime:.2f} см",
      "en": "f' = d·F/(d-F) = {d}×{f}/({d_2}-{f_2}) = {f_prime:.2f} см"
    },
    "s6": {
      "ru": "Г = |f'/d| = |{f_img}/{d_obj}| = {magnification:.4f}",
      "en": "Г = |f'/d| = |{f_img}/{d_obj}| = {magnification:.4f}"
    },
    "s7": {
      "ru": "{f_prime:.2f} см",
      "en": "{f_prime:.2f} см"
    },
    "s8": {
      "ru": "Изображение на бесконечности",
      "en": "Изображение на бесконечности"
    },
    "s9": {
      "ru": "F = R/2 = {R}/2 = {f_mirror} см",
      "en": "F = R/2 = {R}/2 = {f_mirror} см"
    },
    "s10": {
      "ru": "f' = d·R/(2d-R) = {d}×{R}/(2×{d_2}-{R_2}) = {f_prime:.2f} см",
      "en": "f' = d·R/(2d-R) = {d}×{R}/(2×{d_2}-{R_2}) = {f_prime:.2f} см"
    }
